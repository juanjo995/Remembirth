    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[بعد %1$s عيد ميلاد <b>%2$s</b> الـ%3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">غدًا</font></b> عيد ميلاد <b>%2$s</b> الـ%3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">اليوم</font></b> عيد ميلاد <b>%2$s</b> الـ%3$s]]></string>
