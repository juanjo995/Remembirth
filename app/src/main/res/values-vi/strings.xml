    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[Còn %1$s nữa <b>%2$s</b> tròn %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Ngày mai</font></b> <b>%2$s</b> tròn %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Hôm nay</font></b> <b>%2$s</b> tròn %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="other"><![CDATA[<b>%d</b> ngày]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="other"><![CDATA[<b>%d</b> tuổi]]></item>
    </plurals>
