    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[Daqui a %1$s <b>%2$s</b> faz %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Amanhã</font></b> <b>%2$s</b> faz %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Hoje</font></b> <b>%2$s</b> faz %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> dia]]></item>
        <item quantity="many"><![CDATA[<b>%d</b> dias]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> dias]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> ano]]></item>
        <item quantity="many"><![CDATA[<b>%d</b> anos]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> anos]]></item>
    </plurals>
</resources>
