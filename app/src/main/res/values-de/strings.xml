    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[In %1$s wird <b>%2$s</b> %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Morgen</font></b> wird <b>%2$s</b> %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Heute</font></b> wird <b>%2$s</b> %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> Tag]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> Tagen]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b>]]></item>
        <item quantity="other"><![CDATA[<b>%d</b>]]></item>
    </plurals>
</resources>
