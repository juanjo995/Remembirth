    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[<b>%2$s</b> täyttää %1$s päästä %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Huomenna</font></b> <b>%2$s</b> täyttää %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Tänään</font></b> <b>%2$s</b> täyttää %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> päivän]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> päivän]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> vuoden]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> vuotta]]></item>
    </plurals>
