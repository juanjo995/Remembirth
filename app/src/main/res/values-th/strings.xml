    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[อีก %1$s <b>%2$s</b> จะอายุครบ %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">พรุ่งนี้</font></b> <b>%2$s</b> จะอายุครบ %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">วันนี้</font></b> <b>%2$s</b> อายุครบ %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="other"><![CDATA[<b>%d</b> วัน]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="other"><![CDATA[<b>%d</b> ปี]]></item>
    </plurals>
