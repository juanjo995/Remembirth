    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[%1$s 후 <b>%2$s</b> 님이 %3$s가 됩니다]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">내일</font></b> <b>%2$s</b> 님이 %3$s가 됩니다]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">오늘</font></b> <b>%2$s</b> 님이 %3$s가 됩니다]]></string>
    <plurals name="days_phrase">
        <item quantity="other"><![CDATA[<b>%d</b>일]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="other"><![CDATA[<b>%d</b>세]]></item>
    </plurals>
