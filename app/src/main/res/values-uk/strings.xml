    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[<b>%2$s</b>: через %1$s виповниться %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b>%2$s</b>: <b><font color="%4$s">завтра</font></b> виповниться %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b>%2$s</b>: <b><font color="%4$s">сьогодні</font></b> виповнюється %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> день]]></item>
        <item quantity="few"><![CDATA[<b>%d</b> дні]]></item>
        <item quantity="many"><![CDATA[<b>%d</b> днів]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> дня]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> рік]]></item>
        <item quantity="few"><![CDATA[<b>%d</b> роки]]></item>
        <item quantity="many"><![CDATA[<b>%d</b> років]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> року]]></item>
    </plurals>
