    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[Om %1$s fylder <b>%2$s</b> %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">I morgen</font></b> fylder <b>%2$s</b> %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">I dag</font></b> fylder <b>%2$s</b> %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> dag]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> dage]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> år]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> år]]></item>
    </plurals>
</resources>
