    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[Over %1$s wordt <b>%2$s</b> %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Morgen</font></b> wordt <b>%2$s</b> %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Vandaag</font></b> wordt <b>%2$s</b> %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> dag]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> dagen]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b>]]></item>
        <item quantity="other"><![CDATA[<b>%d</b>]]></item>
    </plurals>
</resources>
