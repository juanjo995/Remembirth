    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[%1$s बाद <b>%2$s</b> का %3$s जन्मदिन है]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">कल</font></b> <b>%2$s</b> का %3$s जन्मदिन है]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">आज</font></b> <b>%2$s</b> का %3$s जन्मदिन है]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> दिन]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> दिन]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b>वाँ]]></item>
        <item quantity="other"><![CDATA[<b>%d</b>वाँ]]></item>
    </plurals>
