    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[Za %1$s <b>%2$s</b> skończy %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Jutro</font></b> <b>%2$s</b> skończy %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Dziś</font></b> <b>%2$s</b> kończy %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> dzień]]></item>
        <item quantity="few"><![CDATA[<b>%d</b> dni]]></item>
        <item quantity="many"><![CDATA[<b>%d</b> dni]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> dnia]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> rok]]></item>
        <item quantity="few"><![CDATA[<b>%d</b> lata]]></item>
        <item quantity="many"><![CDATA[<b>%d</b> lat]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> roku]]></item>
    </plurals>
