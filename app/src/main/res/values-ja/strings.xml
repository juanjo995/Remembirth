    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[あと%1$sで<b>%2$s</b>さんが%3$sになります]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">明日</font></b>、<b>%2$s</b>さんが%3$sになります]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">今日</font></b>、<b>%2$s</b>さんが%3$sになります]]></string>
    <plurals name="days_phrase">
        <item quantity="other"><![CDATA[<b>%d</b>日]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="other"><![CDATA[<b>%d</b>歳]]></item>
    </plurals>
