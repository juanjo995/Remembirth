    <!-- Frase de cada cumpleaños (lista y notificaciones).
         %1$s = "N días" (plurals days_phrase), %2$s = nombre, %3$s = "N años" (plurals age_phrase),
         %4$s = color de la palabra Hoy/Mañana (lo pone el código).
         <b> = negrita. CDATA permite escribir las etiquetas tal cual. -->
    <string name="birthday_in_days"><![CDATA[Peste %1$s <b>%2$s</b> împlinește %3$s]]></string>
    <string name="birthday_tomorrow"><![CDATA[<b><font color="%4$s">Mâine</font></b> <b>%2$s</b> împlinește %3$s]]></string>
    <string name="birthday_today"><![CDATA[🎉 <b><font color="%4$s">Astăzi</font></b> <b>%2$s</b> împlinește %3$s]]></string>
    <plurals name="days_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> zi]]></item>
        <item quantity="few"><![CDATA[<b>%d</b> zile]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> de zile]]></item>
    </plurals>
    <plurals name="age_phrase">
        <item quantity="one"><![CDATA[<b>%d</b> an]]></item>
        <item quantity="few"><![CDATA[<b>%d</b> ani]]></item>
        <item quantity="other"><![CDATA[<b>%d</b> de ani]]></item>
    </plurals>
</resources>
